# Z.AI (GLM) — https://z.ai — powers the scoping conversation.
# Without it the chat falls back to the scripted question flow.
# Coding Plan users: the default base URL below is already correct.
# On pay-as-you-go credits instead, set ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=your_zai_api_key_here

# Convex — the backend for leads, chat transcripts and events.
# `npx convex dev` writes these for you; they are not secrets.
# Locally it runs a backend on 127.0.0.1 with no account needed.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Public origin of the deployed site. Used for canonical URLs, the sitemap,
# robots.txt and Open Graph images — all of which need an absolute origin, so
# leaving this unset on production silently points search engines at the
# fallback domain.
NEXT_PUBLIC_SITE_URL=https://plugabyte.com

# Google Search Console verification. Paste the content value from the
# "HTML tag" method; DNS verification needs nothing here.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
