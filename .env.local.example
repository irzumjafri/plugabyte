# Z.AI (GLM) — https://z.ai — powers the scoping conversation.
# Without it the chat falls back to the scripted question flow.
# Coding Plan users: the default base URL below is already correct.
# On pay-as-you-go credits instead, set ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=your_zai_api_key_here

# Convex — the backend for leads, chat transcripts and events.
# `npx convex dev` writes these for you; they are not secrets.
# Locally it runs a backend on 127.0.0.1 with no account needed.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
